# ============================================================
# UMKM Tumbuh Local Development Environment
# Copy this file to .env, then adjust values if needed.
# ============================================================

# App
APP_ENV=development
FRONTEND_URL=http://localhost:5173

# PostgreSQL
POSTGRES_USER=umkm_user
POSTGRES_PASSWORD=umkm_password
POSTGRES_DB=umkm_tumbuh
POSTGRES_PORT=5432

# Auth / JWT
JWT_SECRET=change-this-local-secret
JWT_EXPIRE_MINUTES=1440

# Admin seed account
ADMIN_ID=AKUNADMIN001
ADMIN_FULL_NAME=Admin Pemerintah
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345

# Published host ports. Container ports remain 8080-8083.
# If changed, update the matching URL in frontend/.env.
HOST_BIND_ADDRESS=127.0.0.1
AUTH_SERVICE_PORT=8080
USER_SERVICE_PORT=8081
PARTNERSHIP_SERVICE_PORT=8082
DOCUMENT_SERVICE_PORT=8083
SOAP_SERVICE_PORT=9090

# Local email testing with Mailpit
# Mailpit Web UI: http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@umkm-tumbuh.local
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025

# Garage / S3-compatible object storage
GARAGE_ADMIN_TOKEN=CHANGE_ME_LOCAL_GARAGE_ADMIN_TOKEN
GARAGE_S3_PORT=3900
GARAGE_ADMIN_PORT=3903
OBJECT_STORAGE_ENDPOINT=http://garage:3900
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:3900
OBJECT_STORAGE_REGION=garage
OBJECT_STORAGE_USE_SSL=false
# Compose generates and shares S3 credentials automatically; do not set fake keys.
# If GARAGE_S3_PORT changes, update OBJECT_STORAGE_PUBLIC_ENDPOINT above.
OBJECT_STORAGE_BUCKET_DOCUMENTS=documents
OBJECT_STORAGE_BUCKET_PARTNERSHIP_FILES=partnership-files
